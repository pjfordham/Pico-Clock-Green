.program display_data
.side_set 1                 ; 1 Side-set pin mapped strictly to CLK (Clock)

.wrap_target

    mov osr, null    side 0 ; Populate OSR with absolute zero
    set x, 31        side 0 ; Loop counter for 32 clock cycles
blank_loop:
    out pins, 1      side 0 ; Pulls a zero bit from OSR to the data pin
    jmp x-- blank_loop side 1 ; Pulse CLK high, repeat 32 times

    set pins, 1      side 0 ; Pulse LE HIGH to lock in the blank output
    set pins, 0      side 0 ; Pull LE LOW

    irq wait 0       side 0 ; Signal SM1 to switch rows while panel is dark


    pull block       side 0 ; Wait for and grab fresh DMA data manually
    set x, 31        side 0 ; Loop counter for 32 clock cycles
data_loop:
    out pins, 1       side 0 ; Pulls a true pixel bit from DMA to the data pin
    jmp x-- data_loop side 1 ; Pulse CLK high, repeat 32 times

    set pins, 1      side 0 ; Pulse LE HIGH to lock in the data output
    set pins, 0      side 0 ; Pull LE LOW


    set x, 31        side 0 ; Load pause counter
delay_loop:
    jmp x-- delay_loop [15] side 0
    
.wrap

; A0-A2 should counter over the rows and LE should be pushed hi on each chaneg to latch in the new row data
;  sm_config_set_out_pins(&c_mux, A2, 1);
;  sm_config_set_set_pins(&c_mux, A1, 1);
;  sm_config_set_sideset_pins(&c_mux, A0);

.program display_mux
.side_set 1
.wrap_target

done:

    set y, 1        side 1

low_bits:
    mov osr, ~y side 1
    wait 1 irq 0 side 1    ; 2. Wait for SM0 to finish shifting
    set pins 0 side 0
    out pins 1 side 0
    irq clear 0 side 0

    wait 1 irq 0 side 0    ; 2. Wait for SM0 to finish shifting
    irq clear 0 side 1

    wait 1 irq 0 side 1    ; 2. Wait for SM0 to finish shifting
    set pins 1 side 0
    irq clear 0 side 0

    wait 1 irq 0 side 0    ; 2. Wait for SM0 to finish shifting
    irq clear 0 side 1

    jmp y-- low_bits side 1


.wrap
