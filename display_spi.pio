.program display_data
.side_set 1 optional

.wrap_target
    set x, 31
bit_loop:
    out pins, 1      side 0
    jmp x-- bit_loop side 1
    irq wait 0              ; Signal SM1 and stall here
.wrap


.program display_mux
.side_set 1
.wrap_target
    set x, 3      side 0      ; Initialize loop counter (3 means execute 4 times)
loop_a2_off:
    wait 1 irq 0 side 0     ; 2. Wait for SM0 to finish shifting

    irq 1        side 0     ; 3. Master Trigger: Instantly unblocks display_mux_2

    ; === PERFECT LOCK-STEP CYCLE ===
    set pins, 0  side 1     ; 4. Fires simultaneously with SM2! A1-A2

    irq clear 0  side 0     ; 5. Release SM0 to continue shifting
  jmp x-- loop_a2_off side 0
    set x, 3    side 0         ; Initialize loop counter (3 means execute 4 times)
loop_a2_on:
    wait 1 irq 0 side 0     ; 2. Wait for SM0 to finish shifting

    irq 1        side 0     ; 3. Master Trigger: Instantly unblocks display_mux_2

    ; === PERFECT LOCK-STEP CYCLE ===
    set pins, 1  side 1     ; 4. Fires simultaneously with SM2! A1-A2

    irq clear 0  side 0     ; 5. Release SM0 to continue shifting
  jmp x-- loop_a2_on side 0

.wrap


.program display_mux_2
.side_set 1
.wrap_target
     wait 1 irq 1 side 1    ; 2. Wait for SM1 to give the synchronized "GO"

    ; === PERFECT LOCK-STEP CYCLE ===
    set pins 0 side 0

    irq clear 1 side 0     ; 4. Clean up the sync flag for the next cycle
     wait 1 irq 1 side 0    ; 2. Wait for SM1 to give the synchronized "GO"

    ; === PERFECT LOCK-STEP CYCLE ===
    nop side 1

    irq clear 1   side 1   ; 4. Clean up the sync flag for the next cycle
     wait 1 irq 1 side 1    ; 2. Wait for SM1 to give the synchronized "GO"

    ; === PERFECT LOCK-STEP CYCLE ===
    set pins 1 side 0

    irq clear 1 side 0     ; 4. Clean up the sync flag for the next cycle
     wait 1 irq 1 side 0    ; 2. Wait for SM1 to give the synchronized "GO"

    ; === PERFECT LOCK-STEP CYCLE ===
    nop side 1

    irq clear 1   side 1   ; 4. Clean up the sync flag for the next cycle
.wrap
